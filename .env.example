APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/toonforge.db

# Storage Path
STORAGE_PATH=./storage

# AI Provider Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Visual & Audio Providers
IMAGE_PROVIDER=toon_vector
VOICE_PROVIDER=edge_tts
ANIMATION_PROVIDER=motion_comic

# Video Rendering
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_FPS=30
